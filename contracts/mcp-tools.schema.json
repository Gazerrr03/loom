{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/contracts/mcp-tools.schema.json",
  "title": "Loom MCP Tool Envelope",
  "description": "Versioned, renderer-independent input and output envelopes shared by Codex MCP tools.",
  "oneOf": [
    { "$ref": "#/$defs/toolCall" },
    { "$ref": "#/$defs/toolResult" }
  ],
  "$defs": {
    "toolName": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^\\S+$"
    },
    "revision": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "paths", "changed", "reversible"],
      "properties": {
        "kind": { "enum": ["none", "read", "write"] },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          }
        },
        "changed": { "type": "boolean" },
        "reversible": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "none" } } },
          "then": { "properties": { "paths": { "maxItems": 0 }, "changed": { "const": false } } }
        },
        {
          "if": { "properties": { "kind": { "const": "read" } } },
          "then": { "properties": { "changed": { "const": false } } }
        }
      ]
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message", "objectIds", "fieldPath", "recoverable", "suggestedAction"],
      "properties": {
        "code": {
          "enum": [
            "invalid-envelope",
            "unsupported-version",
            "duplicate-id",
            "dangling-reference",
            "missing-asset",
            "unsupported-capability",
            "unsupported-template",
            "invalid-layout",
            "invalid-tool-input",
            "revision-conflict",
            "render-failed",
            "export-failed"
          ]
        },
        "message": { "type": "string", "minLength": 1 },
        "objectIds": { "type": "array", "items": { "type": "string", "pattern": "^[a-z][a-z0-9._-]*$" } },
        "fieldPath": { "type": ["string", "null"], "pattern": "^[A-Za-z_$][A-Za-z0-9_$]*(?:\\.[A-Za-z_$][A-Za-z0-9_$]*|\\[\\d+\\])*$" },
        "recoverable": { "type": "boolean" },
        "suggestedAction": { "type": ["string", "null"] },
        "suggestedFallback": { "type": "string", "minLength": 1 },
        "cause": { "type": ["string", "null"] }
      }
    },
    "toolCall": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schemaVersion", "toolName", "requestId", "input", "expectedRevision", "dryRun"],
      "properties": {
        "format": { "const": "loom.mcp.tool-call" },
        "schemaVersion": { "const": "0.1.0" },
        "toolName": { "$ref": "#/$defs/toolName" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "input": { "type": "object" },
        "expectedRevision": { "$ref": "#/$defs/revision" },
        "dryRun": { "type": "boolean" }
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "schemaVersion", "toolName", "requestId", "status", "result", "error", "revision", "effects"],
      "properties": {
        "format": { "const": "loom.mcp.tool-result" },
        "schemaVersion": { "const": "0.1.0" },
        "toolName": { "$ref": "#/$defs/toolName" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "status": { "enum": ["ok", "error"] },
        "result": { "type": ["object", "null"] },
        "error": { "oneOf": [{ "$ref": "#/$defs/error" }, { "type": "null" }] },
        "revision": { "$ref": "#/$defs/revision" },
        "effects": { "$ref": "#/$defs/effect" }
      },
      "oneOf": [
        {
          "properties": {
            "status": { "const": "ok" },
            "result": { "type": "object" },
            "error": { "type": "null" }
          }
        },
        {
          "properties": {
            "status": { "const": "error" },
            "result": { "type": "null" },
            "error": { "$ref": "#/$defs/error" }
          }
        }
      ]
    }
  }
}
