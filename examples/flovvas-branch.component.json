  "defaults": { "branchCount": 3, "spread": 0.7, "originRetention": 0.9 },
  "capabilities": { "transforms": ["move", "rotate-y", "scale-uniform", "branch", "distribute"], "supportsLabels": true, "supportsThemeTokens": true, "requires": ["orthographic-camera"] },
