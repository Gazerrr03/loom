{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loom.local/schemas/diagram.schema.json",
  "title": "Loom Diagram Artifact",
  "description": "Canonical renderer-independent asset for an AI-native 3D diagram. The file envelope is strict: unsupported format or schemaVersion values must be rejected. Validation failures use the shared error contract and are never persisted into the artifact.",
  "$comment": "schemaVersion is intentionally a const. A reader must not silently downgrade an unknown future version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "id",
    "metadata",
    "semantic",
    "composition",
    "layout",
    "annotations",
    "presentation",
    "assets"
  ],
  "properties": {
    "format": { "const": "loom.diagram" },
    "schemaVersion": { "const": "0.1.0" },
    "id": { "$ref": "#/$defs/id" },
    "metadata": { "$ref": "#/$defs/metadata" },
    "semantic": { "$ref": "#/$defs/semantic" },
    "composition": { "$ref": "#/$defs/composition" },
    "layout": { "$ref": "#/$defs/layout" },
    "annotations": {
      "type": "array",
      "items": { "$ref": "#/$defs/annotation" }
    },
    "presentation": { "$ref": "#/$defs/presentation" },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]*$"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "createdAt", "updatedAt"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "author": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "semantic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagramFamily", "nodes", "edges", "groups"],
      "properties": {
        "diagramFamily": { "type": "string", "minLength": 1 },
        "nodes": {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        "edges": {
          "type": "array",
          "items": { "$ref": "#/$defs/edge" }
        },
        "groups": {
          "type": "array",
          "items": { "$ref": "#/$defs/group" }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "componentRef"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "componentRef": { "$ref": "#/$defs/id" },
        "visualRole": { "type": "string" },
        "status": { "type": "string" },
        "phase": { "type": "string" },
        "properties": { "type": "object" }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source", "target", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source": {
          "description": "Stable ID of a semantic node; cross-object resolution is checked by the graph contract.",
          "$ref": "#/$defs/id"
        },
        "target": {
          "description": "Stable ID of a semantic node; cross-object resolution is checked by the graph contract.",
          "$ref": "#/$defs/id"
        },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "visualRole": { "type": "string" },
        "properties": { "type": "object" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "children"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "type": { "type": "string", "minLength": 1 },
        "label": { "type": "string" },
        "children": {
          "description": "Stable IDs of semantic nodes contained by this group.",
          "type": "array",
          "items": { "$ref": "#/$defs/id" },
          "uniqueItems": true
        },
        "visualRole": { "type": "string" },
        "properties": { "type": "object" }
      }
    },
    "composition": {
      "description": "Shared physical and viewing coordinate contract for layout, rendering, and export.",
      "type": "object",
      "additionalProperties": false,
      "required": ["unit", "canvas", "pages", "safeAreas", "readingDirection", "defaultView"],
      "properties": {
        "unit": { "enum": ["mm", "px"] },
        "canvas": { "$ref": "#/$defs/canvas" },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/page" }
        },
        "safeAreas": {
          "type": "array",
          "items": { "$ref": "#/$defs/safeArea" }
        },
        "readingDirection": {
          "enum": ["left-to-right", "lower-left-to-upper-right", "top-to-bottom", "freeform"]
        },
        "defaultView": { "$ref": "#/$defs/view" }
      }
    },
    "canvas": {
      "description": "The positive coordinate space expressed in composition.unit.",
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "backgroundToken": { "type": "string" }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "minimum": 0 },
        "height": { "type": "number", "minimum": 0 }
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "bounds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string" },
        "bounds": { "$ref": "#/$defs/rect" }
      }
    },
    "safeArea": {
      "description": "A bounded advisory or protected region. A gutter is centred on a page boundary.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "bounds"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["margin", "gutter", "custom"] },
        "bounds": { "$ref": "#/$defs/rect" },
        "policy": { "enum": ["avoid-critical-content", "avoid-all-content", "advisory"] }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": ["projection", "preset", "azimuthDeg", "elevationDeg", "zoom"],
      "properties": {
        "projection": { "enum": ["orthographic", "perspective"] },
        "preset": { "type": "string" },
        "azimuthDeg": { "type": "number" },
        "elevationDeg": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "layout": {
      "description": "Generated layout is replaceable; overrides are field-level Human Override data.",
      "type": "object",
      "additionalProperties": false,
      "required": ["engine", "generated", "overrides"],
      "properties": {
        "engine": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "version"],
          "properties": {
            "id": { "type": "string" },
            "version": { "type": "string" },
            "seed": {
              "anyOf": [
                { "type": "string" },
                { "type": "number" }
              ]
            }
          }
        },
        "generated": { "$ref": "#/$defs/layoutLayer" },
        "overrides": { "$ref": "#/$defs/overrideLayer" }
      }
    },
    "layoutLayer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "routes", "groups"],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nodeLayout" }
        },
        "routes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/routeLayout" }
        },
        "groups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/groupLayout" }
        }
      }
    },
    "overrideLayer": {
      "description": "Only fields present here are frozen by Human Override; omitted fields continue to follow Generated Layout.",
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "routes", "groups", "view"],
      "properties": {
        "nodes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/nodeOverride" }
        },
        "routes": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/routeOverride" }
        },
        "groups": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/groupOverride" }
        },
        "view": { "$ref": "#/$defs/viewOverride" }
      }
    },
    "nodeLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number", "exclusiveMinimum": 0 },
        "height": { "type": "number", "exclusiveMinimum": 0 },
        "elevation": { "type": "number" },
        "rotationYDeg": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "zIndex": { "type": "integer" },
        "parameters": { "type": "object" }
      }
    },
    "nodeOverride": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "elevation": { "type": "number" },
        "rotationYDeg": { "type": "number" },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "zIndex": { "type": "integer" },
        "componentRef": { "$ref": "#/$defs/id" },
        "parameters": { "type": "object" }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "type": "number" },
        "y": { "type": "number" },
        "elevation": { "type": "number" }
      }
    },
    "routeLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "routeOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "minItems": 2,
          "items": { "$ref": "#/$defs/point" }
        }
      }
    },
    "groupLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounds"],
      "properties": {
        "bounds": { "$ref": "#/$defs/rect" }
      }
    },
    "groupOverride": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bounds"],
      "properties": {
        "bounds": { "$ref": "#/$defs/rect" }
      }
    },
    "viewOverride": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "azimuthDeg": { "type": "number" },
        "elevationDeg": { "type": "number" },
        "zoom": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "anchor", "visualRole"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "text": { "type": "string" },
        "anchor": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "targetId"],
              "properties": {
                "kind": { "enum": ["node", "edge", "group"] },
                "targetId": { "$ref": "#/$defs/id" },
                "offset": { "$ref": "#/$defs/point" }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "position"],
              "properties": {
                "kind": { "const": "canvas" },
                "position": { "$ref": "#/$defs/point" }
              }
            }
          ]
        },
        "visualRole": { "type": "string" },
        "properties": { "type": "object" }
      }
    },
    "presentation": {
      "description": "Persisted theme and role tokens only; renderer scene, GPU, mesh, and cache objects are out of bounds.",
      "type": "object",
      "additionalProperties": false,
      "required": ["themeRef", "roleOverrides"],
      "properties": {
        "themeRef": { "type": "string", "minLength": 1 },
        "roleOverrides": {
          "type": "object",
          "additionalProperties": { "type": "object" }
        }
      }
    },
    "asset": {
      "description": "A portable source reference with explicit license metadata; runtime-loaded assets are not embedded here.",
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "uri", "license"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["primitive", "parametric-scene", "gltf-model", "image", "font"] },
        "uri": { "type": "string", "minLength": 1 },
        "mediaType": { "type": "string" },
        "checksum": { "type": "string" },
        "license": { "type": "string", "minLength": 1 }
      }
    }
  }
}
